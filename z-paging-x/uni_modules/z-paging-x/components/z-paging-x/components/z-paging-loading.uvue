<!-- [z-paging-x]loading -->
<template name="z-paging-loading">
  <!-- #ifndef VUE3-VAPOR -->
  <image ref="loadingImg" class="zpx-loading-img" :src="base64FlowerImg" @transitionend="doRotate"></image>
  <!-- #endif -->
  <!-- #ifdef VUE3-VAPOR -->
  <!-- 蒸汽模式下基于transition的图片旋转在Android上会随节点复用失效，改用HBuilderX 5.0+内置的loading组件(GPU渲染) -->
  <loading class="zpx-loading-vapor" />
  <!-- #endif -->
</template>

<script setup>
  // #ifndef VUE3-VAPOR
  import { ref, onMounted, nextTick } from 'vue'
  import { base64Flower } from '../static/index.uts'

  const times = ref(0)
  // 通过模板ref获取当前实例的图片元素，避免多个loading实例共用固定id时只有一个能旋转
  const loadingImg = ref<UniElement | null>(null)
  const base64FlowerImg = ref(base64Flower)

  // 旋转动画执行
  const doRotate = () => {
    if (loadingImg.value !== null) {
      times.value = times.value + 1;
      loadingImg.value!.style.setProperty('transform', 'rotate(' + times.value * 360 + 'deg)');
      loadingImg.value!.style.setProperty('transition-duration', '1000ms');
    }
  }

  onMounted(() => {
    nextTick(() => {
      setTimeout(() => {
        doRotate();
      }, 10)
    })
  })
  // #endif
</script>

<style>
  .zpx-loading-img {
    width: 34rpx;
    height: 34rpx;
    transition-duration: 2000ms;
    transition-property: transform;
    transition-timing-function: linear;
    transform: rotate(0deg);
  }

  /* 蒸汽模式内置loading组件仅支持width/height/border-color */
  .zpx-loading-vapor {
    width: 34rpx;
    height: 34rpx;
    border-color: #999999;
  }
</style>
