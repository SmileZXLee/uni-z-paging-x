<!-- [z-paging-x]loading -->
<template name="z-paging-loading">
  <image class="zpx-loading-img" :style="[{ transform: 'rotate(' + rotateDeg + 'deg)' }, imgStyle]" :src="finalSrc"></image>
</template>

<script setup lang="uts">
  import { ref, computed, watch, onMounted, onBeforeUnmount } from 'vue'
  import { getLoadingSvg } from '../static/index.uts'

  const props = defineProps({
    // loading颜色
    color: {
      type: String,
      default: '#949494'
    },
    // 自定义loading图片，为空时使用内置loading
    src: {
      type: String,
      default: ''
    },
    // 是否展示旋转动画
    animated: {
      type: Boolean,
      default: true
    },
    // loading样式
    imgStyle: {
      type: Object,
      default: (): UTSJSONObject => ({})
    }
  })

  const finalSrc = computed((): string => {
    return props.src.length > 0 ? props.src : getLoadingSvg(props.color);
  })

  // 当前旋转角度，每秒转一圈，每步30度(与内置loading的12根线条对应)
  const rotateDeg = ref(0)
  let rotateTimer: number = -1

  const startRotate = () => {
    if (!props.animated || rotateTimer != -1) return;
    rotateTimer = setInterval(() => {
      rotateDeg.value = (rotateDeg.value + 30) % 360;
    }, 1000 / 12);
  }

  const stopRotate = () => {
    if (rotateTimer != -1) {
      clearInterval(rotateTimer);
      rotateTimer = -1;
    }
  }

  const animatedComputed = computed((): boolean => props.animated)
  watch(animatedComputed, (newVal: boolean) => {
    if (newVal) {
      startRotate();
    } else {
      stopRotate();
    }
  })

  onMounted(() => {
    startRotate();
  })

  onBeforeUnmount(() => {
    stopRotate();
  })
</script>

<style scoped>
  .zpx-loading-img {
    width: 34rpx;
    height: 34rpx;
  }
</style>
