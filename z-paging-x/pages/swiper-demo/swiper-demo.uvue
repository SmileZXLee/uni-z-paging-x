<!-- 滑动切换选项卡演示 -->

<template>
  <view class="swiper-demo">
    <common-tabs ref="tabs" :list="tabList" @change="tabChange"/>
    <swiper class="swiper" :current="current" @transition="onSwiperTransition" @animationfinish="onSwiperAnimationfinish">
      <swiper-item class="swiper-item" v-for="(_, index) in tabList" :key="index">
        <!-- 这里的swiper-list-item为demo中为演示用定义的组件，列表及分页代码在swiper-list-item组件内 -->
        <!-- 请注意，swiper-list-item非z-paging-x内置组件，在自己的项目中必须自己创建，若未创建则会报组件不存在的错误 -->
        <swiper-list-item :tabIndex="index" :currentIndex="current"></swiper-list-item>
      </swiper-item>
    </swiper>
  </view>
</template>

<script setup lang="uts">
  const tabs = ref<CommonTabsComponentPublicInstance | null>(null)

  const tabList = ref(['测试1', '测试2', '测试3', '测试4'] as string[])
  const current = ref(0)

  const tabChange = (index: number) => {
    current.value = index
  }

  // swiper滑动中
  const onSwiperTransition = (e : SwiperTransitionEvent) => {
    tabs.value?.onSwiperTransition(e)
  }

  // swiper滑动动画结束
  const onSwiperAnimationfinish = (e : SwiperAnimationFinishEvent) => {
    tabs.value?.onSwiperAnimationfinish(e)
    current.value = e.detail.current
  }
</script>

<style>
  .swiper-demo {
    flex: 1;
  }
  
  .swiper {
    flex: 1;
  }
  
  .swiper-item {
    height: 100%;
  }
</style>
