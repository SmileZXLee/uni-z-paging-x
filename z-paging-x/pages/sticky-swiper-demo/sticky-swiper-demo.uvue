<!-- 滑动切换选项卡+吸顶演示 -->

<template>
  <!-- 最外层滚动的z-paging-x容器 -->
  <!-- 非蒸汽模式：外层通过start-nested-scroll + @nestedprescroll与子列表做滚动协商；蒸汽模式不支持滚动协商，由子列表的associative-container开启嵌套模式，外层无需额外配置 -->
  <z-paging-x ref="pagingX" class="sticky-swiper-demo" list-is="scroll-view" :rebound="false"
  <!-- #ifndef VUE3-VAPOR -->
  :start-nested-scroll="true" :nested-scroll-child="nestedScrollChildId" @nestedprescroll="onNestedPreScroll"
  <!-- #endif -->
  @refresh="onRefresh">
    <!-- 自定义下拉刷新view(非必须) -->
    <template #refresher="{ refresherStatus }">
      <custom-refresher :status="refresherStatus"/>
    </template>
    <!-- 顶部跟着滚动的banner -->
    <view ref="header" class="banner-view" style="height: 250rpx;">
      <text style="font-size: 40rpx;font-weight: 700;color: white;">这是一个banner</text>
      <text style="font-size: 28rpx;margin-top: 10rpx;color: white;">下方tab滚动时可吸附在顶部</text>
    </view>
    <!-- tabs + swiper列表容器 -->
    <view class="list-view-container">
      <common-tabs ref="tabs" :list="tabList" @change="tabChange" />
      <swiper class="swiper" :current="current" @transition="onSwiperTransition"
        @animationfinish="onSwiperAnimationfinish">
        <swiper-item class="swiper-item" v-for="(item, index) in tabList" :key="index">
          <!-- 这里的stick-swiper-list-item为demo中为演示用定义的组件，列表及分页代码在stick-swiper-list-item组件内 -->
          <!-- 请注意，stick-swiper-list-item非z-paging-x内置组件，在自己的项目中必须自己创建，若未创建则会报组件不存在的错误 -->
          <!-- id需与nested-scroll-child一致，非蒸汽模式下外层scroll-view惯性滚动时会把滚动传递给对应id的子列表 -->
          <stick-swiper-list-item ref="listItem" :id="item" :tabIndex="index" :currentIndex="current"></stick-swiper-list-item>
        </swiper-item>
      </swiper>
    </view>
  </z-paging-x>
</template>

<script setup lang="uts">
  // 模板 ref
  const pagingX = ref<ZPagingXComponentPublicInstance | null>(null)
  const header = ref<UniElement | null>(null)
  const tabs = ref<CommonTabsComponentPublicInstance | null>(null)
  const listItem = ref<ComponentPublicInstance[] | null>(null)

  // 嵌套滚动子元素的id属性，不支持ref，scroll-view惯性滚动时会让对应id元素视图进行滚动，子元素滚动时会触发scroll-view的nestedprescroll事件
  const nestedScrollChildId = ref('')
  const tabList = ref(['测试1', '测试2', '测试3', '测试4'] as string[])
  const current = ref(0)
  // #ifndef VUE3-VAPOR
  // header高度（不参与模板渲染，使用普通变量），仅滚动协商时需要
  let headerHeight = 0
  // #endif

  onReady(() => {
    // #ifndef VUE3-VAPOR
    // 获取顶部跟着滚动的banner的高度
    headerHeight = header.value!.offsetHeight
    // #endif
    // 设置当前滚动的子组件列表的id
    nestedScrollChildId.value = tabList.value[0]
  })

  // 页面下拉刷新时触发
  const onRefresh = () => {
    // 触发当前子组件刷新，子组件内会触发z-paging-x的列表刷新
    (listItem.value! as ComponentPublicInstance[])[current.value].$callMethod('refresh', () => {
      // 当下拉刷新结束，终止页面下拉刷新
      pagingX.value?.complete([])
    })
  }

  // #ifndef VUE3-VAPOR
  // 子元素滚动时触发，可执行event.consumed(x,y)告知子元素deltaX、deltaY各消耗多少。子元素将执行差值后的deltaX、deltaY滚动距离
  const onNestedPreScroll = (event: NestedPreScrollEvent, scrollViewTarget: UniElement) => {
    const deltaY = event.deltaY
    const scrollTop = scrollViewTarget.scrollTop
    if (deltaY > 0) {
      // 向上滚动，如果父容器 header scrollTop < offsetHeight，先滚动父容器
      if (scrollTop < headerHeight) {
        const difference = headerHeight - scrollTop - deltaY
        // 使得最外层scroll-view滚动到指定位置
        if (difference > 0) {
          scrollViewTarget.scrollBy(event.deltaX, deltaY)
          event.consumed(event.deltaX, deltaY)
        } else {
          const top: number = deltaY + difference
          event.consumed(event.deltaX, top.toFloat())
          scrollViewTarget.scrollBy(event.deltaX, top.toFloat())
        }
      }
    }
  }
  // #endif

  // tabs切换
  const tabChange = (index: number) => {
    current.value = index
    // 设置当前滚动的子组件列表的id
    nestedScrollChildId.value = tabList.value[index]
  }

  // swiper滑动中
  const onSwiperTransition = (e : SwiperTransitionEvent) => {
    tabs.value?.onSwiperTransition(e)
  }

  // swiper滑动动画结束
  const onSwiperAnimationfinish = (e : SwiperAnimationFinishEvent) => {
    tabs.value?.onSwiperAnimationfinish(e)
    current.value = e.detail.current
  }
</script>

<style>
  .sticky-swiper-demo {
    flex: 1;
  }
  
  .banner-view {
    background-color: #007AFF;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  
  .list-view-container {
    height: 100%;
  }

  .swiper {
    flex: 1;
  }
  
  .swiper-item {
    flex: 1;
  }
</style>