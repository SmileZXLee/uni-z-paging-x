<template>
  <!-- 非蒸汽模式：通过custom-nested-scroll与外层scroll-view做滚动协商；蒸汽模式不支持滚动协商，改用associative-container开启嵌套模式 -->
  <z-paging-x v-if="firstLoaded || isCurrentPage" ref="pagingX" v-model="(dataList as ListItem[])"
  :list-id="id" :refresher-enabled="false" :clean-list-when-reload="false"
  <!-- #ifndef VUE3-VAPOR -->
  :custom-nested-scroll="true"
  <!-- #endif -->
  <!-- #ifdef VUE3-VAPOR -->
  associative-container="nested-scroll-view" :rebound="false"
  <!-- #endif -->
  @query="queryList">
    <list-item v-for="(item, index) in dataList" :key="index">
      <view class="list-item">
        <text class="list-item-title">{{item.title}}</text>
        <text class="list-item-type">{{item.detail}}</text>
      </view>
    </list-item>
  </z-paging-x>
</template>

<script setup lang="uts">
  import { requestList, ListItem } from '@/http/request.uts'

  defineOptions({
    name: 'stick-swiper-list-item',
    // 样式隔离策略2.0下组件默认不能引用App.uvue中的全局class，此处允许全局样式(.list-item等)作用于本组件
    styleIsolation: 'app'
  })

  const props = defineProps({
    // 当前组件的index，也就是当前组件是swiper中的第几个
    tabIndex: {
      type: Number,
      default: 0
    },
    // 当前swiper切换到第几个index
    currentIndex: {
      type: Number,
      default: 0
    },
    // listView的id
    id: {
      type: String,
      default: ''
    }
  })

  const pagingX = ref<ZPagingXComponentPublicInstance | null>(null)

  const dataList = ref<ListItem[]>([])
  // 当前组件是否已经加载过了
  const firstLoaded = ref(false)
  // 是否滚动到当前页
  const isCurrentPage = ref(false)
  // 列表刷新结束回调
  let refreshComplete: (() => void) | null = null

  watch((): number => props.currentIndex, (newVal: number) => {
    if (newVal === props.tabIndex) {
      // 懒加载，当滑动到当前的item时，才去加载
      if (!firstLoaded.value) {
        nextTick(() => {
          isCurrentPage.value = true
        })
      }
    }
  }, { immediate: true })

  // 供页面通过 ref 调用：触发列表刷新，刷新结束后回调 complete
  const refresh = (complete: (() => void) | null) => {
    refreshComplete = complete
    pagingX.value?.reload()
  }

  const queryList = (pageNo: number, pageSize: number) => {
    const params = {
      pageNo: pageNo,
      pageSize: pageSize,
      type: props.tabIndex + 1
    }
    requestList(params).then((res: UTSJSONObject) => {
      pagingX.value?.complete(res.getArray('data'))
      // 通知页面结束下拉刷新
      if (pageNo == 1 && refreshComplete != null) {
        refreshComplete!()
      }
      // 设置当前组件已经加载过了，必须设置
      firstLoaded.value = true
    })
  }

  defineExpose({
    refresh
  })
</script>

